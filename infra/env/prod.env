# Production environment — sourced by infra/deploy.sh and infra/setup-gcp.sh.
# Anything that differs between prod and staging lives here.

PROJECT_ID="bizkaia-conn-pub"
REGION="europe-southwest1"
AR_REPO="bizkaia-images"
SERVICE="bizkaia-api"
SA_NAME="bizkaia-backend"
BUCKET="bizkaia-data-pub"
SECRET_NAME="bizkaia-jwt-secret"
ENVIRONMENT="production"

# Cloud Run sizing
MEMORY="2Gi"
CPU="1"
MIN_INSTANCES="0"
MAX_INSTANCES="5"
TIMEOUT_SECONDS="120"

# CORS allowlist regex — matches Cloud Run revisions and Vercel hosts.
CORS_ORIGIN_REGEX='^https://(bizkaia-api-[a-z0-9-]+\.a\.run\.app|frontend-[a-z0-9-]+\.vercel\.app|[a-z0-9-]+-alessandrovoltan-4656s-projects\.vercel\.app)$'
