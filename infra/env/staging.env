# Staging environment — separate GCP project for full isolation from prod.
# Same regions/sizing as prod so canary issues there are realistic.

PROJECT_ID="bizkaia-conn-staging"
REGION="europe-southwest1"
AR_REPO="bizkaia-images"
SERVICE="bizkaia-api-staging"
SA_NAME="bizkaia-backend"
BUCKET="bizkaia-data-staging"
SECRET_NAME="bizkaia-jwt-secret"
ENVIRONMENT="staging"

# Cloud Run sizing — same as prod so contention shows up at the same load.
MEMORY="2Gi"
CPU="1"
MIN_INSTANCES="0"
MAX_INSTANCES="5"
TIMEOUT_SECONDS="120"

# CORS allowlist regex — staging accepts staging API revisions and any
# Vercel preview deployment, since previews are how we exercise it.
CORS_ORIGIN_REGEX='^https://(bizkaia-api-staging-[a-z0-9-]+\.a\.run\.app|frontend(-[a-z0-9-]+)?\.vercel\.app|[a-z0-9-]+-alessandrovoltan-4656s-projects\.vercel\.app)$'
